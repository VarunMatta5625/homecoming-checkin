# Copy to .env.local for local development. Both values come from Supabase: Project Settings, API.
# The publishable (anon) key is safe in the browser. Never put the service_role / secret key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Leave both empty to run on built-in fake demo data (local development only).
# A production build (npm run build) fails without them, unless you set:
# VITE_DEMO=true
